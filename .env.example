# VELORA environment configuration — EXAMPLE ONLY.
# Copy to `.env` for local development and fill in real values there.
# Never put real credentials in this file: CI checks that every value is empty or a placeholder.

# Runtime environment: development | test | staging | production
VELORA_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
VELORA_LOG_LEVEL=INFO

# Database connection for the runtime role (app_rw). Placeholder only.
VELORA_DATABASE_URL=CHANGE_ME

# Migrator connection (velora_owner), used only by `python -m velora.db migrate`.
VELORA_MIGRATION_DATABASE_URL=CHANGE_ME

# Administrator connection, used only by `python -m velora.db setup-roles`.
VELORA_ADMIN_DATABASE_URL=CHANGE_ME

# Staff dashboard origin. Magic links point here (https outside development). Placeholder only.
VELORA_PUBLIC_BASE_URL=CHANGE_ME

# Founder onboarding tools (velora_platform), used only by `python -m velora.admin`.
VELORA_PLATFORM_DATABASE_URL=CHANGE_ME

# Worker work discovery (velora_dispatcher), used only by `python -m velora.workers`.
VELORA_DISPATCHER_DATABASE_URL=CHANGE_ME

# Your name, recorded in the audit log for every onboarding action.
VELORA_OPERATOR=

# AI proposals for free-text orders (P6, AD-30). Leave empty to use the numbered menu only.
# Groq API key; real keys go only in your uncommitted `.env`.
VELORA_GROQ_API_KEY=
# Groq model id (default openai/gpt-oss-20b) and the timeout before falling back to the menu.
VELORA_AI_MODEL=
VELORA_AI_TIMEOUT_SECONDS=

# Log format: json (default; one redacted JSON object per line) | text (readable, local only).
VELORA_LOG_FORMAT=

# Founder's monitor (P10), `python -m velora.monitoring run`. Placeholder only.
# Connection for velora_monitor (reads counts and states across tenants, never content).
VELORA_MONITOR_DATABASE_URL=CHANGE_ME
# The API's readiness URL on the private network, e.g. http://api:8000/readyz.
VELORA_MONITOR_PROBE_URL=
# Dead man's switch: pinged every minute; an external service alerts when pings stop.
VELORA_MONITOR_HEARTBEAT_URL=
# Where alerts go (never WhatsApp). At least one is required in staging and production.
# A webhook receives a JSON POST (e.g. a push or SMS gateway for the founder's phone).
VELORA_ALERT_WEBHOOK_URL=
# Email: comma-separated recipients and an SMTP server with TLS (port 587 STARTTLS or 465).
VELORA_ALERT_EMAIL_TO=
VELORA_SMTP_HOST=
VELORA_SMTP_PORT=
VELORA_SMTP_FROM=
VELORA_SMTP_USERNAME=
VELORA_SMTP_PASSWORD=
# Alert when no good backup is recorded within this many minutes (default 120). Backups are
# expected from staging on; set true/false to override.
VELORA_MONITOR_EXPECT_BACKUPS=
VELORA_BACKUP_MAX_AGE_MINUTES=
